# Local development only (never committed). Copy to `.env` and fill in.
# In deployed Databricks Apps these come from app.yaml / bundle vars instead.

# Databricks CLI profile to auth against (see `databricks auth profiles`).
DATABRICKS_CONFIG_PROFILE=your_profile
# Or set host + token directly instead of a profile:
# DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com

DATABRICKS_WAREHOUSE_ID=your_sql_warehouse_id
DATABRICKS_SERVING_ENDPOINT_NAME=databricks-claude-sonnet-4-5

# Unity Catalog catalog/schema that hold the app's tables.
AIMAPPER_CATALOG=your_catalog
AIMAPPER_SCHEMA=aimapper

# Optional: Vector Search index over reference-PDF passages (grounds mappings).
# Leave empty to disable. Populate from `setup/create_reference_index.sh`.
AIMAPPER_DOCS_INDEX=

# Optional: Vector Search index for semantic few-shot retrieval over approved
# examples + history. Leave empty to use lexical retrieval. From setup/create_vector_index.sh.
AIMAPPER_VS_ENDPOINT=
AIMAPPER_VS_INDEX=

DATABRICKS_APP_PORT=8000
FLASK_RUN_HOST=0.0.0.0
